# =============================================================================
# Secrets — NUNCA commitar
# =============================================================================

# Variáveis de ambiente. Mantém só o `.env.example` (template público).
.env
.env.*
!.env.example
!.env.*.example

# Chaves criptográficas e certificados
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.jks

# Credenciais de provedores (OpenAI, GCP Document AI, AWS, Azure)
*-credentials.json
*-service-account*.json
gcp-*.json
google-creds*.json
service-account*.json
secret*.json
secrets/
*.token
oauth-token*.json

# Anotações com credenciais de teste em texto plano (uso local de DEV)
instrucao/instrucao.md


# =============================================================================
# Dados locais e uploads — não pertencem ao repo
# =============================================================================

# Storage local (PDFs, áudios, etc) e dumps de banco
/data/
/storage/
*.sqlite
*.sqlite3
*.db
*.sql
*.sql.gz
*.dump
*.dump.gz
*.bak

# Exceção: migrations versionadas DEVEM ser commitadas. A regra `*.sql` acima
# existe para dumps de banco — não para o schema versionado em db/migrations/.
# (As migrations 001–012 foram adicionadas com `git add -f`; esta negação evita
# que qualquer migration futura seja silenciosamente ignorada.)
!db/migrations/*.sql

# Uploads de PDF (Bella Cobranças, samples) — exceto package `api/storage/`
*.pdf
!api/storage/
!web/public/**/*.pdf

# Uploads de áudio (Bella Atas — Whisper STT)
*.mp3
*.m4a
*.wav
*.ogg
*.webm
*.flac
*.aac
*.opus


