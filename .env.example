# =============================================================================
# Assistente Virtual de Condomínios — variáveis de ambiente
# =============================================================================
# Copie para .env e preencha. NUNCA commitar .env.
# Em produção, valores vêm de AWS Secrets Manager / Azure Key Vault.

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Postgres (local via docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=avc
POSTGRES_PASSWORD=trocar-em-prod
POSTGRES_DB=assistente_condominios

# Connection string usada pela API (asyncpg)
DATABASE_URL=postgresql+asyncpg://avc:trocar-em-prod@localhost:5432/assistente_condominios

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
# Chave de API com permissão para text-embedding-3-large e GPT-5.2
OPEN_AI_KEY=sk-proj-SUBSTITUIR

# -----------------------------------------------------------------------------
# Anthropic (Claude)
# -----------------------------------------------------------------------------
# Usado pelo QAService (branch recalibração) e futuros agentes.
# Opcional agora — o Bloco 6 do demo precisa desta chave preenchida.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Em produção, gerar com `openssl rand -hex 32`
SECRET_KEY_JWT=GERAR_COM_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=480

# -----------------------------------------------------------------------------
# Object Storage (PDFs e anexos)
# -----------------------------------------------------------------------------
# Provider: s3 | azure_blob | local (dev only)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/storage

# AWS S3 (quando STORAGE_PROVIDER=s3)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Azure Blob (quando STORAGE_PROVIDER=azure_blob)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_BLOB_CONTAINER=

# -----------------------------------------------------------------------------
# Pipeline de Ingestão
# -----------------------------------------------------------------------------
# Defaults espelhando o pipeline Spark original da Lello
INGESTION_BATCH_SIZE=100
INGESTION_MAX_WORKERS=10
INGESTION_OPENAI_TIMEOUT=30
INGESTION_OPENAI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_TENANT=lello
